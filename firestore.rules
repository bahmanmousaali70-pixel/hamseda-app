rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything not explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticatedDevice() {
      // Device pairing uses Firebase anonymous auth; Google/email verification is not required.
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSpaceMember(spaceId) {
      return isAuthenticatedDevice()
        && (
          exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
          || (exists(/databases/$(database)/documents/spaces/$(spaceId))
            && get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerUid == request.auth.uid)
        );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'activeSpaceId', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('activeSpaceId' in data) || (data.activeSpaceId is string && isValidId(data.activeSpaceId)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSpace(data) {
      return data.keys().hasAll(['ownerUid', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'ownerEmail', 'partnerEmail', 'title', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && isValidId(data.ownerUid)
        && (!('partnerEmail' in data) || (data.partnerEmail is string && data.partnerEmail.size() <= 254))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMember(data, memberUid) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'joinedAt'])
        && data.uid is string && data.uid == memberUid && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role is string && data.role in ['owner', 'partner']
        && data.joinedAt is timestamp;
    }

    function isValidGoal(data, goalId) {
      return data.keys().hasAll(['id', 'title', 'owner', 'category', 'timeBlock', 'priority', 'completed', 'dateKey', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'owner', 'scope', 'category', 'timeBlock', 'priority', 'completed', 'dateKey', 'reminderTime', 'reminderVoice', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == goalId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && (!('scope' in data) || (data.scope is string && data.scope in ['home', 'work']))
        && data.category is string && data.category in ['purpose', 'health', 'relationship', 'work', 'growth']
        && data.timeBlock is string && data.timeBlock in ['morning', 'afternoon', 'evening']
        && data.priority is string && data.priority in ['high', 'normal']
        && data.completed is bool
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 20
        && (!('reminderTime' in data) || (data.reminderTime is string && data.reminderTime.size() <= 10 && data.reminderTime.matches('^(\\d{2}:\\d{2})?$')))
        && (!('reminderVoice' in data) || (data.reminderVoice is string && data.reminderVoice in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir']))
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHabit(data, habitId) {
      return data.keys().hasAll(['id', 'title', 'owner', 'completedDates', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'owner', 'completedDates', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == habitId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && data.completedDates is list && data.completedDates.size() <= 365
        && (data.completedDates.size() == 0 || (data.completedDates[0] is string && data.completedDates[0].size() <= 20))
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGratitude(data, entryId) {
      return data.keys().hasAll(['id', 'dateKey', 'jalaliDate', 'author', 'mood', 'items', 'loveNote', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'dateKey', 'jalaliDate', 'author', 'mood', 'items', 'loveNote', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == entryId && isValidId(data.id)
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 20
        && data.jalaliDate is string && data.jalaliDate.size() >= 1 && data.jalaliDate.size() <= 80
        && data.author is string && data.author in ['man', 'zari', 'both']
        && data.mood is string && data.mood in ['energetic', 'grateful', 'calm', 'focused', 'needs_boost']
        && data.items is list && data.items.size() == 3
        && data.items[0] is string && data.items[0].size() <= 300
        && data.items[1] is string && data.items[1].size() <= 300
        && data.items[2] is string && data.items[2].size() <= 300
        && data.loveNote is string && data.loveNote.size() <= 600
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCaller(data, callerId) {
      return data.keys().hasAll(['id', 'name', 'relation', 'template', 'repeatCount', 'chimeStyle', 'voiceName', 'favorite', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'latinAlias', 'persianPhonetic', 'relation', 'template', 'repeatCount', 'chimeStyle', 'voiceName', 'favorite', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == callerId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('latinAlias' in data) || (data.latinAlias is string && data.latinAlias.size() <= 120))
        && (!('persianPhonetic' in data) || (data.persianPhonetic is string && data.persianPhonetic.size() <= 120))
        && data.relation is string && data.relation.size() <= 80
        && data.template is string && data.template.size() >= 1 && data.template.size() <= 240
        && data.repeatCount is number && data.repeatCount in [1, 2]
        && data.chimeStyle is string && data.chimeStyle in ['gentle', 'classic', 'chime']
        && data.voiceName is string && data.voiceName in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir']
        && data.favorite is bool
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data, scheduleId) {
      return data.keys().hasAll(['id', 'title', 'topic', 'time', 'enabled', 'voiceName', 'days', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'topic', 'time', 'enabled', 'voiceName', 'customText', 'days', 'lastTriggeredDate', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == scheduleId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.topic is string && data.topic in ['morning', 'goals', 'gratitude', 'energy', 'night_movies', 'custom']
        && data.time is string && data.time.matches('^\\d{2}:\\d{2}$')
        && data.enabled is bool
        && data.voiceName is string && data.voiceName in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir']
        && (!('customText' in data) || (data.customText is string && data.customText.size() <= 600))
        && data.days is string && data.days in ['daily', 'weekdays', 'weekends']
        && (!('lastTriggeredDate' in data) || (data.lastTriggeredDate is string && data.lastTriggeredDate.size() <= 20))
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSpaceSettings(data) {
      return data.keys().hasAll(['theme', 'defaultVoice', 'speechRate', 'myName', 'partnerName', 'backgroundKeepAlive', 'updatedByUid', 'updatedAt'])
        && data.keys().hasOnly(['theme', 'defaultVoice', 'speechRate', 'myName', 'partnerName', 'assistantName', 'assistantWakeWordEnabled', 'backgroundKeepAlive', 'announceCalls', 'announceSms', 'autoOpenMorning', 'nightMovieAutoCheck', 'nightMovieTime', 'updatedByUid', 'updatedAt'])
        && data.theme is string && data.theme in ['light', 'dark']
        && data.defaultVoice is string && data.defaultVoice in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir']
        && data.speechRate is number && data.speechRate >= 0.5 && data.speechRate <= 2.0
        && data.myName is string && data.myName.size() >= 1 && data.myName.size() <= 60
        && data.partnerName is string && data.partnerName.size() >= 1 && data.partnerName.size() <= 60
        && (!('assistantName' in data) || (data.assistantName is string && data.assistantName.size() >= 1 && data.assistantName.size() <= 60))
        && (!('assistantWakeWordEnabled' in data) || data.assistantWakeWordEnabled is bool)
        && data.backgroundKeepAlive is bool
        && (!('announceCalls' in data) || data.announceCalls is bool)
        && (!('announceSms' in data) || data.announceSms is bool)
        && (!('autoOpenMorning' in data) || data.autoOpenMorning is bool)
        && (!('nightMovieAutoCheck' in data) || data.nightMovieAutoCheck is bool)
        && (!('nightMovieTime' in data) || (data.nightMovieTime is string && data.nightMovieTime.size() <= 10 && data.nightMovieTime.matches('^\\d{2}:\\d{2}$')))
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.updatedAt is timestamp;
    }

    function isValidShopping(data, itemId) {
      return data.keys().hasAll(['id', 'title', 'category', 'checked', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'note', 'category', 'checked', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == itemId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('note' in data) || (data.note is string && data.note.size() <= 200))
        && data.category is string && data.category in ['grocery', 'home', 'health', 'note']
        && data.checked is bool
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, expenseId) {
      return data.keys().hasAll(['id', 'title', 'amount', 'category', 'payer', 'dateKey', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'amount', 'category', 'payer', 'splitMode', 'dateKey', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == expenseId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.amount is number && data.amount >= 0 && data.amount <= 999999999999
        && data.category is string && data.category in ['food', 'bills', 'transport', 'health', 'family', 'other']
        && data.payer is string && data.payer in ['man', 'zari', 'both']
        && (!('splitMode' in data) || (data.splitMode is string && data.splitMode in ['shared', 'personal', 'for_partner', 'settlement']))
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 20
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBill(data, billId) {
      return data.keys().hasAll(['id', 'title', 'amount', 'kind', 'dueDateKey', 'cycle', 'paid', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'amount', 'kind', 'dueDateKey', 'cycle', 'paid', 'note', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == billId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.amount is number && data.amount >= 0 && data.amount <= 999999999999
        && data.kind is string && data.kind in ['installment', 'bill', 'vehicle', 'subscription']
        && data.dueDateKey is string && data.dueDateKey.size() >= 8 && data.dueDateKey.size() <= 20
        && data.cycle is string && data.cycle in ['once', 'monthly', 'yearly']
        && data.paid is bool
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMedication(data, medId) {
      return data.keys().hasAll(['id', 'name', 'dosage', 'time', 'owner', 'kind', 'takenDates', 'voiceRemind', 'enabled', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'dosage', 'time', 'owner', 'kind', 'takenDates', 'voiceRemind', 'enabled', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == medId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.dosage is string && data.dosage.size() <= 160
        && data.time is string && data.time.matches('^\\d{2}:\\d{2}$')
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && data.kind is string && data.kind in ['med', 'appointment']
        && data.takenDates is list && data.takenDates.size() <= 365
        && (data.takenDates.size() == 0 || (data.takenDates[0] is string && data.takenDates[0].size() <= 20))
        && data.voiceRemind is bool
        && data.enabled is bool
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMealPlan(data, mealId) {
      return data.keys().hasAll(['id', 'dayLabel', 'lunch', 'dinner', 'ingredients', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'dayLabel', 'lunch', 'dinner', 'ingredients', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == mealId && isValidId(data.id)
        && data.dayLabel is string && data.dayLabel.size() >= 1 && data.dayLabel.size() <= 40
        && data.lunch is string && data.lunch.size() <= 200
        && data.dinner is string && data.dinner.size() <= 200
        && data.ingredients is string && data.ingredients.size() <= 400
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVaultNote(data, noteId) {
      return data.keys().hasAll(['id', 'title', 'value', 'category', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'value', 'category', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == noteId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.value is string && data.value.size() >= 1 && data.value.size() <= 500
        && data.category is string && data.category in ['bank', 'home', 'ids', 'note']
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPacking(data, itemId) {
      return data.keys().hasAll(['id', 'title', 'template', 'checked', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'template', 'checked', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == itemId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.template is string && data.template in ['road', 'flight', 'camp', 'custom']
        && data.checked is bool
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSpecialEvent(data, eventId) {
      return data.keys().hasAll(['id', 'title', 'kind', 'jalaliMonth', 'jalaliDay', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'kind', 'jalaliMonth', 'jalaliDay', 'jalaliYear', 'owner', 'note', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == eventId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.kind is string && data.kind in ['birthday', 'anniversary', 'occasion']
        && data.jalaliMonth is number && data.jalaliMonth >= 1 && data.jalaliMonth <= 12
        && data.jalaliDay is number && data.jalaliDay >= 1 && data.jalaliDay <= 31
        && (!('jalaliYear' in data) || (data.jalaliYear is number && data.jalaliYear >= 1300 && data.jalaliYear <= 1500))
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHomeChore(data, choreId) {
      return data.keys().hasAll(['id', 'title', 'area', 'intervalDays', 'lastDoneDateKey', 'nextDueDateKey', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'area', 'intervalDays', 'lastDoneDateKey', 'nextDueDateKey', 'owner', 'clientCreatedAt', 'authorUid', 'updatedByUid', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == choreId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.area is string && data.area.size() >= 1 && data.area.size() <= 80
        && data.intervalDays is number && data.intervalDays >= 1 && data.intervalDays <= 3650
        && data.lastDoneDateKey is string && data.lastDoneDateKey.size() >= 8 && data.lastDoneDateKey.size() <= 20
        && data.nextDueDateKey is string && data.nextDueDateKey.size() >= 8 && data.nextDueDateKey.size() <= 20
        && data.owner is string && data.owner in ['man', 'zari', 'both']
        && data.clientCreatedAt is number
        && data.authorUid is string && isValidId(data.authorUid)
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isAuthenticatedDevice() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isAuthenticatedDevice()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAuthenticatedDevice()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'activeSpaceId', 'updatedAt']);
      allow delete: if isAuthenticatedDevice() && isValidId(userId) && request.auth.uid == userId;
    }

    match /spaces/{spaceId} {
      // Space IDs are random 192-bit bearer codes shared by the owner.
      allow get: if isAuthenticatedDevice() && isValidId(spaceId);
      allow list: if isAuthenticatedDevice()
        && (
          resource.data.ownerUid == request.auth.uid
        );
      allow create: if isAuthenticatedDevice()
        && isValidId(spaceId)
        && isValidSpace(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAuthenticatedDevice()
        && isValidId(spaceId)
        && isValidSpace(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if isAuthenticatedDevice() && isValidId(spaceId) && existing().ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isAuthenticatedDevice()
          && isValidId(spaceId)
          && isValidId(memberUid)
          && (memberUid == request.auth.uid || isSpaceMember(spaceId));
        allow list: if isAuthenticatedDevice()
          && isSpaceMember(spaceId)
          && (get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerUid == request.auth.uid
            || resource.data.uid is string);
        allow create: if isAuthenticatedDevice()
          && isValidId(spaceId)
          && isValidId(memberUid)
          && memberUid == request.auth.uid
          && isValidMember(incoming(), memberUid)
          && incoming().joinedAt == request.time
          && exists(/databases/$(database)/documents/spaces/$(spaceId))
          && (
            (incoming().role == 'owner'
